{
  "manifest_version": 2,
  "name": "offread",
  "version": "0.1.0",
  "description": "Snapshot the active page, sanitize it, and render it locally with no network egress.",
  "permissions": ["storage", "webRequest", "webRequestBlocking", "<all_urls>"],
  "browser_action": {
    "default_title": "offread",
    "default_icon": "icons/offread.svg"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "web_accessible_resources": ["viewer.html", "viewer.css", "viewer.js", "icons/offread.svg"],
  "browser_specific_settings": {
    "gecko": {
      "id": "offread@local"
    }
  }
}